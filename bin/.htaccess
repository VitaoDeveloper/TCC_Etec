# Bloqueia acesso web a este diretório.
# O PHP continua lendo os arquivos normalmente — só o navegador é impedido.
# Funciona em qualquer subpasta, porque o Apache aplica o .htaccess do
# diretório acessado, independentemente de onde o app esteja instalado.
#
# Por que bin/ também é bloqueado: migrate.php é uma ferramenta de linha de
# comando que aplica DDL no banco. A proteção principal está no próprio
# script (recusa quando PHP_SAPI !== 'cli'), e isto aqui é a segunda camada.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Belt-and-suspenders: mesmo que o mod_authz falhe, desliga o interpretador.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
