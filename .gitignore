# Arquivos de ambiente.
# O padrão antigo listava só ".env" e ".env.prod" e deixou o ".env.tcc"
# (que continha credenciais reais) ser commitado. O padrão abaixo cobre
# qualquer variante, e a exceção seguinte mantém o exemplo versionado.
.env
.env.*
!.env.example

test
vendor
node_modules
storage/*
!storage/.htaccess

# Upload de usuário (avatares, comprovantes enviados pelo painel) é conteúdo
# de runtime e não deve ser versionado. O .htaccess do diretório continua
# versionado pelo mesmo motivo do storage.
assets/uploads/*
!assets/uploads/.htaccess

.phpunit.cache/
.phpunit.result.cache

# .env.tcc já está no histórico de todas as branches. Ignorar o arquivo
# só impede novos commits; para removê-lo de vez é preciso rotacionar a
# credencial e reescrever o histórico (git filter-repo/BFG) com force-push.
