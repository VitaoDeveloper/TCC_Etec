# Database credentials
DB_HOST=localhost
DB_NAME=e5_royaltech
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# SMTP (Mail server) credentials
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM=

# ============================================================
# SuperFrete (entrega/shipping)
# ============================================================
# Token = Bearer. Gerar em <ambiente>/#/integrations > "Integrar em Desenvolvedores".
# Nunca commitar este arquivo (.env). NUNCA logar o token completo.
SUPERFRETE_TOKEN=

# URL base com barra final.
# Sandbox: https://sandbox.superfrete.com/
# Producao: https://api.superfrete.com/
SUPERFRETE_BASE_URL=https://sandbox.superfrete.com/

# User-Agent obrigatorio: "NomeDaApp versao (email_de_contato)".
SUPERFRETE_USER_AGENT=RoyalTech 1.0 (integracao@superfrete.com)

# CEP de origem (loja) usado na cotacao — 8 digitos sem hifen.
SUPERFRETE_ORIGIN_POSTAL_CODE=01310100

# secret_token devolvido na resposta de POST /api/v0/webhook.
# Usado para validar assinatura HMAC-SHA256 (header X-ME-Signature).
# NUNCA logar este valor completo — mostrar apenas ultimos 4 caracteres.
SUPERFRETE_WEBHOOK_SECRET=

# URL publica para receber webhooks (deve ser HTTPS em producao).
SUPERFRETE_WEBHOOK_URL=https://seudominio.com/webhook/superfrete
