# Database credentials
DB_HOST=localhost
DB_NAME=e5_royaltech
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# SMTP (Mail server) credentials
# Desenvolvimento (Mailpit local): host=localhost, port=1025, sem auth/criptografia.
# Docker Compose: use o hostname do servico, ex.: MAIL_HOST=mailpit
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
# Opcional: remetente padrao. Se vazio, usa store_email da configuracao da loja.
MAIL_FROM=

# Store settings (defaults estaticos em includes/config.php podem ser
# sobrescritos pelo painel admin e ficam persistidos na tabela e5_settings).
