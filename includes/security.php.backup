<?php
/**
 * Security and Encryption Utilities
 * 
 * Purpose: Centralized security functions for sensitive data handling
 * - API key encryption/decryption
 * - CNPJ validation with checksum
 * - CSRF protection (already exists in csrf.php)
 * - Input sanitization
 */

/**
 * Encrypt sensitive data using OpenSSL AES-256-GCM
 * 
 * NOTE: Uses AES-256-GCM (OpenSSL), not Sodium, due to XAMPP PHP compilation.
 * Provides equivalent security with authenticated encryption.
 * 
 * @param string $plaintext Data to encrypt
 * @param string $key Encryption key (must be 32 bytes)
 * @return string Base64-encoded encrypted data with IV and tag
 */
function secureEncrypt(string $plaintext, string $key): string
{
    if (strlen($key) !== 32) {
        throw new InvalidArgumentException('Encryption key must be 32 bytes');
    }
    
    $iv = random_bytes(16); // AES-256-GCM uses 16-byte IV
    $tag = '';
    
    $ciphertext = openssl_encrypt(
        $plaintext,
        'aes-256-gcm',
        $key,
        OPENSSL_RAW_DATA,
        $iv,
        $tag,
        '',
        16
    );
    
    if ($ciphertext === false) {
        throw new RuntimeException('Encryption failed');
    }
    
    // Store IV + tag + ciphertext together
    return base64_encode($iv . $tag . $ciphertext);
}

/**
 * Decrypt data encrypted with secureEncrypt()
 * 
 * @param string $encrypted Base64-encoded encrypted data
 * @param string $key Encryption key (must be 32 bytes)
 * @return string|false Decrypted plaintext or false on failure
 */
function secureDecrypt(string $encrypted, string $key)
{
    if (strlen($key) !== SODIUM_CRYPTO_SECRETBOX_KEYBYTES) {
        return false;
    }
    
    $decoded = base64_decode($encrypted);
    if ($decoded === false || strlen($decoded) < SODIUM_CRYPTO_SECRETBOX_NONCEBYTES) {
        return false;
    }
    
    $nonce = substr($decoded, 0, SODIUM_CRYPTO_SECRETBOX_NONCEBYTES);
    $ciphertext = substr($decoded, SODIUM_CRYPTO_SECRETBOX_NONCEBYTES);
    
    $plaintext = sodium_crypto_secretbox_open($ciphertext, $nonce, $key);
    
    return $plaintext !== false ? $plaintext : false;
}

/**
 * Get or create encryption key for application
 * 
 * @return string 32-byte encryption key
 */
function getEncryptionKey(): string
{
    $keyFile = __DIR__ . '/../.encryption_key';
    
    // Check if key file exists
    if (file_exists($keyFile)) {
        $key = file_get_contents($keyFile);
        if (strlen($key) === SODIUM_CRYPTO_SECRETBOX_KEYBYTES) {
            return $key;
        }
    }
    
    // Generate new key
    $key = random_bytes(SODIUM_CRYPTO_SECRETBOX_KEYBYTES);
    
    // Save to file (outside webroot in production!)
    file_put_contents($keyFile, $key);
    chmod($keyFile, 0600); // Read/write for owner only
    
    return $key;
}

/**
 * Validate CNPJ with official checksum algorithm
 * 
 * @param string $cnpj CNPJ to validate (with or without formatting)
 * @return bool True if valid
 */
function validateCNPJ(string $cnpj): bool
{
    // Remove formatting
    $cnpj = preg_replace('/\D/', '', $cnpj);
    
    // Must be 14 digits
    if (strlen($cnpj) !== 14) {
        return false;
    }
    
    // Reject known invalid patterns
    $invalidPatterns = [
        '00000000000000', '11111111111111', '22222222222222', '33333333333333',
        '44444444444444', '55555555555555', '66666666666666', '77777777777777',
        '88888888888888', '99999999999999'
    ];
    
    if (in_array($cnpj, $invalidPatterns)) {
        return false;
    }
    
    // Calculate first check digit
    $sum = 0;
    $weights = [5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2];
    
    for ($i = 0; $i < 12; $i++) {
        $sum += (int)$cnpj[$i] * $weights[$i];
    }
    
    $remainder = $sum % 11;
    $checkDigit1 = $remainder < 2 ? 0 : 11 - $remainder;
    
    if ((int)$cnpj[12] !== $checkDigit1) {
        return false;
    }
    
    // Calculate second check digit
    $sum = 0;
    $weights = [6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2];
    
    for ($i = 0; $i < 13; $i++) {
        $sum += (int)$cnpj[$i] * $weights[$i];
    }
    
    $remainder = $sum % 11;
    $checkDigit2 = $remainder < 2 ? 0 : 11 - $remainder;
    
    return (int)$cnpj[13] === $checkDigit2;
}

/**
 * Validate CPF with official checksum algorithm
 * 
 * @param string $cpf CPF to validate (with or without formatting)
 * @return bool True if valid
 */
function validateCPF(string $cpf): bool
{
    // Remove formatting
    $cpf = preg_replace('/\D/', '', $cpf);
    
    // Must be 11 digits
    if (strlen($cpf) !== 11) {
        return false;
    }
    
    // Reject known invalid patterns
    $invalidPatterns = [
        '00000000000', '11111111111', '22222222222', '33333333333',
        '44444444444', '55555555555', '66666666666', '77777777777',
        '88888888888', '99999999999'
    ];
    
    if (in_array($cpf, $invalidPatterns)) {
        return false;
    }
    
    // Calculate first check digit
    $sum = 0;
    for ($i = 0; $i < 9; $i++) {
        $sum += (int)$cpf[$i] * (10 - $i);
    }
    
    $remainder = $sum % 11;
    $checkDigit1 = $remainder < 2 ? 0 : 11 - $remainder;
    
    if ((int)$cpf[9] !== $checkDigit1) {
        return false;
    }
    
    // Calculate second check digit
    $sum = 0;
    for ($i = 0; $i < 10; $i++) {
        $sum += (int)$cpf[$i] * (11 - $i);
    }
    
    $remainder = $sum % 11;
    $checkDigit2 = $remainder < 2 ? 0 : 11 - $remainder;
    
    return (int)$cpf[10] === $checkDigit2;
}

/**
 * Format CNPJ for display
 * 
 * @param string $cnpj CNPJ to format
 * @return string Formatted CNPJ (00.000.000/0000-00)
 */
function formatCNPJ(string $cnpj): string
{
    $cnpj = preg_replace('/\D/', '', $cnpj);
    
    if (strlen($cnpj) !== 14) {
        return $cnpj;
    }
    
    return sprintf(
        '%s.%s.%s/%s-%s',
        substr($cnpj, 0, 2),
        substr($cnpj, 2, 3),
        substr($cnpj, 5, 3),
        substr($cnpj, 8, 4),
        substr($cnpj, 12, 2)
    );
}

/**
 * Format CPF for display
 * 
 * @param string $cpf CPF to format
 * @return string Formatted CPF (000.000.000-00)
 */
function formatCPF(string $cpf): string
{
    $cpf = preg_replace('/\D/', '', $cpf);
    
    if (strlen($cpf) !== 11) {
        return $cpf;
    }
    
    return sprintf(
        '%s.%s.%s-%s',
        substr($cpf, 0, 3),
        substr($cpf, 3, 3),
        substr($cpf, 6, 3),
        substr($cpf, 9, 2)
    );
}

/**
 * Save encrypted setting to database
 * 
 * @param PDO $pdo Database connection
 * @param string $key Setting key
 * @param string $value Plain text value to encrypt
 * @return bool Success
 */
function saveEncryptedSetting(PDO $pdo, string $key, string $value): bool
{
    try {
        $encryptionKey = getEncryptionKey();
        $encrypted = secureEncrypt($value, $encryptionKey);
        
        $stmt = $pdo->prepare('
            INSERT INTO e5_encrypted_settings (setting_key, encrypted_value, encryption_version)
            VALUES (:key, :value, :version)
            ON DUPLICATE KEY UPDATE 
                encrypted_value = VALUES(encrypted_value),
                encryption_version = VALUES(encryption_version),
                updated_at = NOW()
        ');
        
        return $stmt->execute([
            ':key' => $key,
            ':value' => $encrypted,
            ':version' => 'v1',
        ]);
        
    } catch (Throwable $e) {
        error_log('Failed to save encrypted setting: ' . $e->getMessage());
        return false;
    }
}

/**
 * Load encrypted setting from database
 * 
 * @param PDO $pdo Database connection
 * @param string $key Setting key
 * @return string|null Decrypted value or null if not found/failed
 */
function loadEncryptedSetting(PDO $pdo, string $key): ?string
{
    try {
        $stmt = $pdo->prepare('SELECT encrypted_value FROM e5_encrypted_settings WHERE setting_key = :key LIMIT 1');
        $stmt->execute([':key' => $key]);
        $row = $stmt->fetch();
        
        if (!$row) {
            return null;
        }
        
        $encryptionKey = getEncryptionKey();
        $decrypted = secureDecrypt($row['encrypted_value'], $encryptionKey);
        
        return $decrypted !== false ? $decrypted : null;
        
    } catch (Throwable $e) {
        error_log('Failed to load encrypted setting: ' . $e->getMessage());
        return null;
    }
}

/**
 * Log regime change attempt
 * 
 * @param PDO $pdo Database connection
 * @param int $userId Admin user ID performing the change
 * @param string $oldRegime Previous regime
 * @param string $newRegime New regime
 * @param bool $success Whether the change succeeded
 * @param string|null $errorMessage Error message if failed
 * @param string|null $cnpj CNPJ if activating MEI
 * @return void
 */
function logRegimeChange(
    PDO $pdo,
    int $userId,
    string $oldRegime,
    string $newRegime,
    bool $success,
    ?string $errorMessage = null,
    ?string $cnpj = null
): void {
    try {
        $stmt = $pdo->prepare('
            INSERT INTO e5_system_change_log 
                (change_type, user_id, regime_anterior, regime_novo, ip_address, user_agent, success, error_message, cnpj)
            VALUES 
                (:type, :user_id, :old, :new, :ip, :ua, :success, :error, :cnpj)
        ');
        
        $stmt->execute([
            ':user_id' => $userId,
            ':old' => $oldRegime,
            ':new' => $newRegime,
            ':ip' => $_SERVER['REMOTE_ADDR'] ?? '0.0.0.0',
            ':ua' => substr($_SERVER['HTTP_USER_AGENT'] ?? 'Unknown', 0, 500),
            ':success' => $success ? 1 : 0,
            ':error' => $errorMessage,
            ':cnpj' => $cnpj,
        ]);
        
    } catch (Throwable $e) {
        error_log('Failed to log regime change: ' . $e->getMessage());
    }
}

/**
 * Get client IP address (supports proxy headers)
 * 
 * @return string IP address
 */
function getClientIP(): string
{
    // Check for proxies
    $headers = [
        'HTTP_CF_CONNECTING_IP', // Cloudflare
        'HTTP_X_FORWARDED_FOR',
        'HTTP_X_REAL_IP',
        'REMOTE_ADDR',
    ];
    
    foreach ($headers as $header) {
        if (!empty($_SERVER[$header])) {
            $ip = $_SERVER[$header];
            
            // X-Forwarded-For can have multiple IPs
            if (strpos($ip, ',') !== false) {
                $ips = explode(',', $ip);
                $ip = trim($ips[0]);
            }
            
            // Validate IP
            if (filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE)) {
                return $ip;
            }
        }
    }
    
    return $_SERVER['REMOTE_ADDR'] ?? '0.0.0.0';
}

/**
 * Sanitize CNPJ/CPF input
 * 
 * @param string $document Document number
 * @return string Sanitized document (only digits)
 */
function sanitizeDocument(string $document): string
{
    return preg_replace('/\D/', '', $document);
}

/**
 * Check if user has admin role
 * 
 * @return bool True if admin
 */
function isAdmin(): bool
{
    return isset($_SESSION['user_role']) && $_SESSION['user_role'] === 'admin';
}

/**
 * Require admin authentication or die
 * 
 * @return void
 */
function requireAdmin(): void
{
    session_start();
    
    if (!isset($_SESSION['user_id']) || !isAdmin()) {
        http_response_code(403);
        die('Acesso negado. Apenas administradores podem acessar esta página.');
    }
}
