# ============================================================
# .htaccess — Royal Tech E-commerce
# ============================================================

RewriteEngine On

# ============================================================
# SEGURANÇA
# ============================================================

# Bloquear acesso a diretórios sensíveis.
#
# IMPORTANTE: o app roda em SUBDIRETÓRIO (/TCC_Etec), mas o Apache compara
# estes padrões contra o caminho INTEIRO da URL. Um padrão ancorado com ^
# no diretório raiz (ex.: ^/includes/) NÃO casa com /TCC_Etec/includes/ e
# por isso não protegia nada. Por isso os padrões usam "(^|/)", que casa
# em qualquer nível de subpasta.
#
# Cada um desses diretórios também tem o próprio .htaccess com "Require all
# denied" (defesa em profundidade, funciona mesmo se este arquivo for lido
# antes das regras de diretório).
RedirectMatch 403 (^|/)includes/
RedirectMatch 403 (^|/)database/
RedirectMatch 403 (^|/)storage/
RedirectMatch 403 (^|/)scripts/
RedirectMatch 403 (^|/)tests/
RedirectMatch 403 (^|/)vendor/
RedirectMatch 403 (^|/)\.git/
RedirectMatch 403 (^|/)config\.php$
RedirectMatch 403 (^|/)opencode\.json$
RedirectMatch 403 (^|/)\.gitignore$

# Desligar listagem de diretórios
Options -Indexes

# Bloquear acesso a arquivos ocultos
RedirectMatch 403 /\..*$

# Headers de segurança
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ============================================================
# CACHE DE ASSETS
# ============================================================

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# O servidor nao tinha mime type para .ico e servia o favicon sem
# Content-Type. O logo/favicon agora sao versionados em assets/img/site/.
<IfModule mod_mime.c>
    AddType image/vnd.microsoft.icon .ico
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml font/woff2
</IfModule>

# ============================================================
# PÁGINA DE ERRO PERSONALIZADA
# ============================================================
#
# ATENÇÃO: o ErrorDocument recebe um caminho a partir da RAIZ DO SERVIDOR,
# não a partir desta pasta. Se o app for movido de /TCC_Etec para outro
# lugar, estes dois caminhos precisam ser ajustados junto.
#
# 500 aponta para uma página própria (e não para o 404): devolver 404 em
# erro interno mente para o cliente e confunde o retry de serviços
# externos — foi assim que a SuperFrete passou a retentar webhook 5x.

ErrorDocument 404 /TCC_Etec/pages/404.php
ErrorDocument 500 /TCC_Etec/pages/500.php

# ============================================================
# URL REWRITING — AMIGÁVEIS
# ============================================================

# Produto individual: /produto/123
RewriteRule ^produto/([0-9]+)$ pages/products/product-detail.php?id=$1 [L,QSA]

# Categoria: /categoria/slug-da-categoria
RewriteRule ^categoria/([a-zA-Z0-9_-]+)$ pages/products/categories.php?slug=$1 [L,QSA]

# Páginas principais
RewriteRule ^produtos$ pages/products/products.php [L,QSA]
RewriteRule ^carrinho$ pages/cart/cart.php [L,QSA]
RewriteRule ^checkout$ pages/cart/checkout.php [L,QSA]
RewriteRule ^login$ pages/auth/login.php [L,QSA]
RewriteRule ^cadastro$ pages/auth/register.php [L,QSA]
RewriteRule ^contato$ pages/products/contact.php [L,QSA]
RewriteRule ^sobre$ pages/products/about.php [L,QSA]
RewriteRule ^perfil$ pages/auth/profile.php [L,QSA]
RewriteRule ^meus-pedidos$ pages/auth/orders.php [L,QSA]
RewriteRule ^esqueci-senha$ pages/auth/forgot-password.php [L,QSA]

# Admin
RewriteRule ^admin$ pages/admin/index.php [L,QSA]
RewriteRule ^admin/produtos$ pages/admin/products.php [L,QSA]
RewriteRule ^admin/pedidos$ pages/admin/orders.php [L,QSA]
RewriteRule ^admin/clientes$ pages/admin/customers.php [L,QSA]
RewriteRule ^admin/categorias$ pages/admin/categories.php [L,QSA]
RewriteRule ^admin/banners$ pages/admin/banners.php [L,QSA]
RewriteRule ^admin/relatorios$ pages/admin/reports.php [L,QSA]
RewriteRule ^admin/configuracoes$ pages/admin/settings.php [L,QSA]


